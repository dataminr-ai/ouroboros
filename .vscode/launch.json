    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": false,
        },
        {
            "name": "Run Dataset Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "justMyCode": false,
            "args": [
                "tests/datasets/test_dataset.py"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Train Cache Contrastive",
            "type": "debugpy",
            "request": "launch",
            "program": "src/ouroboros/training_cache.py",
            "console": "integratedTerminal",
            "args": [
                "--train_file", "data/cnn_daily_mail/train.jsonl", 
                "--validation_file", "data/cnn_daily_mail/validation.jsonl",
                "--validation_steps", "50", 
                "--max_seq_len", "127",
                "--decoder", "state-spaces/mamba-130m-hf",
                "--output_dir", "ckpt/cnn-daily-mail-130m-generative/",
                "--batch_size", "16",
                "--checkpointing_steps", "100",
                "--learning_rate", "5e-5", 
                "--logging_steps", "1",
                "--overwrite_cache",
                "--stream_dataset"
            ],
            "justMyCode": false
        },
        {
            "name": "Train Cache Generative",
            "type": "debugpy",
            "request": "launch",
            "program": "src/ouroboros/training_cache.py",
            "console": "integratedTerminal",
            "args": [
                "--train_file", "data/cnn_daily_mail/train.jsonl", 
                "--validation_file", "data/cnn_daily_mail/validation.jsonl",
                "--validation_steps", "1", 
                "--max_seq_len", "512",
                "--decoder", "state-spaces/mamba-130m-hf",
                "--output_dir", "ckpt/cnn-daily-mail-130m-generative/",
                "--batch_size", "16",
                "--checkpointing_steps", "100",
                "--learning_rate", "5e-5", 
                "--logging_steps", "1",
                "--max_train_steps", "3",
                "--validation_limit", "3",
                "--overwrite_cache",
                "--stream_dataset",
                "--generative"
            ],
            "justMyCode": false
        }
    ]
}